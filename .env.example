# Shared local runtime
NODE_ENV=development

# Local host access for npm run dev
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/multi_atendimento?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:15432/multi_atendimento?schema=public
REDIS_URL=redis://localhost:16379

# Container access used by Docker Compose services
POSTGRES_DB=multi_atendimento
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
API_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/multi_atendimento?schema=public
API_REDIS_URL=redis://redis:6379

# Host ports bound to 127.0.0.1 by docker-compose.dev.yml
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
API_HOST_PORT=4100
WEB_HOST_PORT=3000
EVOLUTION_HOST_PORT=8082

# API
API_PORT=4100
API_HEALTH_PATH=/health
JWT_SECRET=change-me-before-production
WEBHOOK_PUBLIC_URL=http://localhost:4100/webhooks/evolution
EVOLUTION_BASE_URL=http://localhost:8082
EVOLUTION_GLOBAL_API_KEY=change-me
EVOLUTION_MANAGER_URL=http://localhost:8082/manager

# Evolution Go container
EVOLUTION_IMAGE=evoapicloud/evolution-go:latest
EVOLUTION_CLIENT_NAME=multi-atendimento
EVOLUTION_POSTGRES_AUTH_DB=postgresql://postgres:postgres@postgres:5432/multi_atendimento?sslmode=disable
EVOLUTION_POSTGRES_USERS_DB=postgresql://postgres:postgres@postgres:5432/multi_atendimento?sslmode=disable
EVOLUTION_WEBHOOK_URL=http://api:4000/webhooks/evolution
EVOLUTION_DATABASE_SAVE_MESSAGES=false
EVOLUTION_AMQP_URL=
EVOLUTION_NATS_URL=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_WS_URL=http://localhost:4100
NEXT_PUBLIC_EVOLUTION_MANAGER_URL=http://localhost:8082/manager
NEXT_PUBLIC_SUPABASE_URL=https://api.supabase.devizando.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
