# Copy to .env.supabase.local and replace [YOUR-PASSWORD] before running remote migration.
# Do not commit .env.supabase.local.

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@161.97.113.95:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@161.97.113.95:5432/postgres?schema=public

NEXT_PUBLIC_SUPABASE_URL=https://api.supabase.devizando.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]

# Self-hosted Supabase migration, used on the VPS by scripts/migrate-supabase-selfhost.sh.
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=[YOUR-PASSWORD]
DB_HOST=db
DB_PORT=5432
DB_CONTAINER=supabase-db
DOCKER_NETWORK=supabase_default
