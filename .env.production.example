# Copy to .env.production on the VPS and replace every placeholder before deploy.
NODE_ENV=production
COMPOSE_PROJECT_NAME=multi-atendimento

# Bind application ports to localhost for a reverse proxy on the same VPS.
# Change *_HOST_BIND only when you intentionally want direct public exposure.
WEB_HOST_BIND=127.0.0.1
WEB_HOST_PORT=3000
API_HOST_BIND=127.0.0.1
API_HOST_PORT=4100
EVOLUTION_HOST_BIND=127.0.0.1
EVOLUTION_HOST_PORT=8082

# PostgreSQL
POSTGRES_DB=multi_atendimento
POSTGRES_USER=multi_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
API_DATABASE_URL=postgresql://multi_app:replace-with-a-long-random-password@postgres:5432/multi_atendimento?schema=public
DIRECT_URL=postgresql://multi_app:replace-with-a-long-random-password@postgres:5432/multi_atendimento?schema=public
API_REDIS_URL=redis://redis:6379

# API
API_HEALTH_PATH=/health
JWT_SECRET=replace-with-at-least-32-random-bytes
WEBHOOK_PUBLIC_URL=https://api.example.com/webhooks/evolution

# Evolution Go
# Replace :latest with a tested immutable tag or digest after the pilot smoke test.
EVOLUTION_IMAGE=evoapicloud/evolution-go:latest
EVOLUTION_CLIENT_NAME=multi-atendimento
EVOLUTION_GLOBAL_API_KEY=replace-with-a-long-random-api-key
EVOLUTION_BASE_URL=http://localhost:8082
EVOLUTION_MANAGER_URL=http://localhost:8082/manager
EVOLUTION_POSTGRES_AUTH_DB=postgresql://multi_app:replace-with-a-long-random-password@postgres:5432/multi_atendimento?sslmode=disable
EVOLUTION_POSTGRES_USERS_DB=postgresql://multi_app:replace-with-a-long-random-password@postgres:5432/multi_atendimento?sslmode=disable
EVOLUTION_WEBHOOK_URL=http://api:4000/webhooks/evolution
EVOLUTION_DATABASE_SAVE_MESSAGES=false
EVOLUTION_AMQP_URL=
EVOLUTION_NATS_URL=

# Public browser URLs baked into the web build.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_WS_URL=wss://api.example.com
NEXT_PUBLIC_EVOLUTION_MANAGER_URL=https://evolution.example.com/manager
NEXT_PUBLIC_SUPABASE_URL=https://api.supabase.devizando.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
